# Backend Environment Configuration Template

# Server Port (defaults to 5000 if not specified; Render automatically assigns PORT in production)
PORT=5000
NODE_ENV=development

# Allowed Client Origin for CORS and Socket.IO handshakes
CLIENT_URL=http://localhost:5173

# PostgreSQL / Neon Database Connection String
# Replace the placeholder credentials with your Neon project connection string.
# Example: postgresql://username:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# Disable Prisma CLI network telemetry checks
CHECKPOINT_DISABLE=1
