{
  "name": "web3task-watch-party",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready YouTube Watch Party application with real-time synchronization",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "start:server": "npm run start --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:validate": "npm run prisma:validate --workspace=server",
    "prisma:deploy": "npm run prisma:deploy --workspace=server",
    "test": "npm run test --workspace=server",
    "test:all": "npm run test:all --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
